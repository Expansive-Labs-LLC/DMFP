---
/**
 * Driving route from the house to a facility, via Google Maps.
 *
 * DEVIATION from DESIGN-PLAN §4 (self-hosted MapLibre) and SPEC-DMFP-FE-0102
 * SEC-003 (no third-party scripts) — owner decision 2026-07-26.
 *
 * Owner 2026-07-27: the map renders BY DEFAULT. This drops the click-to-load
 * mitigation, so every visitor's IP reaches Google on page load whether or not they
 * wanted a map. Two things still hold the line:
 *   1. `loading="lazy"` — the frame is not fetched until it scrolls into view.
 *   2. NO KEY, NO FRAME. Without a key the component renders a plain directions link
 *      instead. It never embeds a broken or unkeyed frame.
 *
 * SEC-008 is now load-bearing rather than tidy: /privacy MUST disclose the IP
 * sharing before launch, because the visitor no longer opts in by clicking.
 */
import { isTbd } from '../lib/fact';
import { property } from '../data/site.config';

interface Props {
  facilityName: string;
  destAddress: unknown;
  apiKey: unknown;
}
const { facilityName, destAddress, apiKey } = Astro.props;

const a = property.address;
const origin = `${a.street}, ${a.locality}, ${a.region} ${a.postalCode}`;
const destination = isTbd(destAddress)
  ? `${facilityName}, ${a.locality}, ${a.region}`
  : String(destAddress);
const destIsApproximate = isTbd(destAddress);

const q = encodeURIComponent;
/** Official URL scheme — no key, no frame, nothing loads until clicked. */
const linkUrl = `https://www.google.com/maps/dir/?api=1&origin=${q(origin)}&destination=${q(destination)}&travelmode=driving`;
const embedUrl = isTbd(apiKey)
  ? null
  : `https://www.google.com/maps/embed/v1/directions?key=${q(String(apiKey))}&origin=${q(origin)}&destination=${q(destination)}&mode=driving`;
---

<div class="route">
  {
    embedUrl ? (
      <Fragment>
        <iframe
          src={embedUrl}
          title={`Driving route from ${a.street} to ${facilityName}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        />
        <p class="small muted">
          Map data © Google. Loading this map shares your IP address with Google — see{' '}
          <a href="/privacy">Privacy</a>.
        </p>
      </Fragment>
    ) : (
      <p class="small">
        <a href={linkUrl} rel="noopener noreferrer" target="_blank">
          Driving directions to {facilityName} →
        </a>
        <span class="muted"> opens Google Maps</span>
      </p>
    )
  }
</div>

<style>
  .route { margin-block: var(--s4); }
  iframe { width: 100%; height: 420px; border: 1px solid var(--limestone-edge); display: block; }
</style>
