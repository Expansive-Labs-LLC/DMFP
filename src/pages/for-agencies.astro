---
/** `/for-agencies` — no marketing voice. Availability stated BEFORE terms. */
import Base from '../layouts/Base.astro';
import Fact from '../components/Fact.astro';
import { machine } from '../lib/fact';
import FactTable from '../components/FactTable.astro';
import { site, property, home, services } from '../data/site.config';
const t = home.terms;
const a = home.availability;
const ap = property.applications;
/** Derive the dial string from config — never write a number twice. */
const partnerPortal = services.find((sv) => sv.id === 'partner-portal');
const digits = machine(site.contact.phone)?.replace(/\D/g, '');
const telHref = digits ? `tel:+1${digits}` : undefined;
---
<Base title="For agencies" description="Terms, availability and application process for housing coordinators placing clinicians.">
  <section class="wrap stack">
    <h1 class="display-l">For agencies</h1>

    <div class="contact">
      <p><strong>{site.entity.legalName}</strong></p>
      <p>Contact: <Fact value={site.contact.name} /></p>
      <p class="mono">
        {telHref ? <a href={telHref}>{site.contact.phone}</a> : <Fact value={site.contact.phone} />}
      </p>
      <p><Fact value={site.contact.email} /></p>
    </div>

    <div class="availability">
      <h2>Availability</h2>
      <p class="measure">
        Renovation is in progress. <strong>No beds are available before {a.availableFrom}.</strong>
        Bedrooms: {home.bedrooms}, with {home.bathroomsFull} full baths and {home.kitchens} kitchens.
        Applications are {ap.open ? 'open now' : 'not open'} for {ap.forOccupancy} occupancy.
      </p>
    </div>

    <h2>Terms</h2>
    <FactTable
      columns={['Item', 'Value']}
      rows={[
        { head: 'Minimum contract', cells: [t.minTerm] },
        { head: 'Maximum contract', cells: [t.maxTerm] },
        { head: 'Rate — one bedroom, per week', cells: [`From ${t.rateRoomWeeklyFrom} — see the unit table`] },
        { head: 'Rate — one unit, per week', cells: [t.rateUnitWeekly] },
        { head: 'Rate — whole building, per week', cells: [t.rateHouseWeekly] },
        { head: 'In the rate', cells: [t.utilities.included] },
        { head: 'Billed separately', cells: [`Parking ${home.parking.priceWeekly}, ${home.parking.availability}`] },
        { head: 'Deposit', cells: [t.deposit] },
        { head: 'Payment terms', cells: [t.paymentTerms] },
        { head: 'Lead time needed', cells: [t.leadTime] },
      ]} />

    <h2>Access and monitoring</h2>
    <p class="measure">
      {home.security.locks}. A {home.security.system} camera system covers the entrances and exterior
      — {home.security.cameras.map((c) => `${c.count}× ${c.type.toLowerCase()}`).join(', ')}.
      {' '}{home.security.neverCovered} {home.security.residentAccess}
      Disclose this to anyone you place; it is a condition of the stay, not a perk.
    </p>

    <h2>The two units</h2>
    <p class="measure">
      The building divides into {home.divisible.units} self-contained units with separately split
      utilities, so each can carry its own leasing agreement rather than one agreement with an internal
      cost-share. <strong>They are not equivalent</strong> — compare before you place anyone.
    </p>
    <FactTable
      columns={['Unit', 'Room / week', 'Bedrooms', 'Full baths', 'Kitchen', 'Other space']}
      rows={home.divisible.list.map((u) => ({
        head: u.label,
        cells: [
          u.roomRateWeekly,
          String(u.bedrooms),
          String(u.bathroomsFull),
          u.kitchen,
          u.spaces.length ? u.spaces.join(', ') : 'None',
        ],
      }))}
    />
    <p class="measure small">
      {home.divisible.list[1].label} has no common space other than the kitchenette. The living room and
      business center are in {home.divisible.list[0].label}.
    </p>

    <h2>Rooms</h2>
    <p class="measure small">{home.terms.roomPricingRule}</p>
    <p class="measure small">
      {home.terms.accessNote} Tell anyone you place which floor their room is on.
    </p>
    <FactTable
      columns={['Room', 'Unit', 'Floor', 'Size', 'Floor area', 'Per week']}
      rows={home.divisible.list.flatMap((u) =>
        u.rooms.map((r) => ({
          head: r.label,
          cells: [
            u.label,
            r.floor,
            `${r.widthFt} × ${r.lengthFt} ft`,
            `${(r.widthFt * r.lengthFt).toFixed(0)} sq ft`,
            r.rateWeekly,
          ],
        }))
      )}
    />

    <h2>Application process</h2>
    <ol class="measure steps">{ap.process.map((step) => <li>{step}</li>)}</ol>
    <p class="measure">Fee: <Fact value={ap.fee} />.</p>
    <p class="measure">
      {ap.platform === null
        ? 'The application itself is completed off-site; we send it by email after an inquiry.'
        : `The application is completed at ${ap.platform}.`}
    </p>

    <h2>Documents</h2>
    <p class="measure">
      W-9 and certificate of insurance on request. Turnaround: <Fact value={site.documents.turnaround} />.
    </p>

    <h2>Partner portal — 2027</h2>
    <p class="measure">
      {partnerPortal?.description} Approved partners will register themselves rather than waiting on us.
    </p>
    <p class="measure small">
      Not built yet, and dated deliberately: <strong>coming in {partnerPortal?.liveFrom}</strong>. Until
      then, placements go through the process above and door access is issued by us before arrival.
    </p>

    <h2>Capacity</h2>
    <p class="measure">
      One property, {home.bedrooms} bedrooms. That is the ceiling today.
    </p>

    <p class="small"><a href="/inquire">Send a placement inquiry</a>.</p>
  </section>
</Base>
<style>
  section { padding-block: var(--s12) var(--s8); }
  .contact p, .availability p { margin: 0 0 var(--s2); }
  .steps { padding-left: var(--s6); }
  .steps li + li { margin-top: var(--s2); }
  .availability { border-left: 3px solid var(--signal); padding-left: var(--s4); }
  @media print {
    :global(.site-head), :global(.site-foot), .small a { display: none; }
    :global(table) { break-inside: avoid; }
  }
</style>
