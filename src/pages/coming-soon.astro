---
/**
 * /coming-soon — the ENTIRE public surface while PUBLIC_COMING_SOON=1.
 *
 * Owner decision 2026-08-08: until launch, the public site states that the brand
 * exists and is coming, and nothing more. The full site continues to build and
 * pass every gate in CI so launch never waits on rot; integrations/coming-soon.mjs
 * prunes the published artifact down to this one page (served at `/`, which is why
 * the canonical below points at the site root, not at /coming-soon/).
 *
 * Deliberately not using Base.astro: the shared layout carries the nav, the street
 * address, and the contact block — all of which are "more". This page renders the
 * brand, the coming-soon line, and the EHO statement (FR-010 — required on every
 * emitted page, and this is an emitted page). Facts still come from site.config.ts.
 */
import { site } from '../data/site.config';
import '../styles/tokens.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.brand}</title>
    <meta name="description" content="Coming soon." />
    <link rel="canonical" href={new URL('/', Astro.site)} />
  </head>
  <body>
    <main>
      <h1>{site.brand}</h1>
      <p class="soon">Coming soon.</p>
      <p class="eho">{site.legal.eho}</p>
    </main>

    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: var(--paper);
        color: var(--text);
        font-family: var(--font-body);
      }
      main {
        max-width: var(--measure);
        padding: var(--s8);
        text-align: center;
      }
      h1 {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.5rem;
        margin: 0 0 var(--s2);
      }
      .soon {
        color: var(--text-muted);
        margin: 0 0 var(--s12);
      }
      .eho {
        color: var(--text-muted);
        font-size: 0.8125rem;
        margin: 0;
      }
    </style>
  </body>
</html>
