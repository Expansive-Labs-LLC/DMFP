---
/** `/the-house` — CONTENT-OUTLINE. Inverted for pre-leasing (§13.3): facts lead, photos slot in. */
import Base from '../layouts/Base.astro';
import Fact from '../components/Fact.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { property, home } from '../data/site.config';
---
<Base title="The house" description="A furnished six-bedroom house in Detroit's New Center area, currently being renovated for September 2026 occupancy.">
  <section class="wrap stack">
    <h1 class="display-l">The house.</h1>
    <p class="measure">
      {home.bedrooms} bedrooms, {home.bathroomsFull} full bathrooms, {home.kitchens} kitchens.
      Furnished, {home.laundry} laundry, {home.entrance} entrance.
    </p>

    <ImageSlot value={property.photos.exteriorFront} eager
      alt={`The front of ${property.address.street}, seen from the street.`}
      caption="The building as it stands today." />

    <h2>Renovation status</h2>
    <p class="measure">
      The house is being renovated now. Rooms are photographed as they're finished and posted here as
      they're done. Target: <Fact value={property.rehab.completionTarget} />.
    </p>

    <h2>Kitchen</h2>
    <p class="measure">Two kitchens. Appliances: <Fact value={home.kitchen.appliances} />.</p>
    <p class="measure">Cookware: <Fact value={home.kitchen.cookware} />.</p>

    <h2>Laundry</h2>
    <p class="measure">{home.laundry} laundry.</p>

    <h2>Parking</h2>
    <p class="measure">{home.parking} <a href="/commute">Distances to each facility →</a></p>

    <h2>Internet</h2>
    <p class="measure">
      A {home.internet.tier.toLowerCase()}-tier connection rated {home.internet.ratedDown} down,
      {' '}<Fact value={home.internet.ratedUp} /> up. That is the plan rating, not a measurement.
    </p>
    <p class="measure small">
      Measured throughput: <Fact value={home.internet.down} /> down,
      {' '}<Fact value={home.internet.up} /> up, on <Fact value={home.internet.measuredAt} />.
      Speeds are measured in the finished house, not quoted from the contract.
    </p>

    <h2>Entry and access</h2>
    <p class="measure">{home.entry.floor}. <Fact value={home.entry.steps} /> steps at the entry.</p>

    <h2>Business center</h2>
    <p class="measure">
      A dedicated room with 3 desks. Each has a monitor, keyboard and mouse on a single dongle, so one
      cable from your laptop is the whole setup — nothing to carry, nothing to reconfigure. There is a
      printer. Three of six residents can work at once without anyone using a bed or a shared kitchen
      table as a desk.
    </p>

    <h2>Access</h2>
    <p class="measure">
      {home.security.locks}. There are no keys to collect or hand back, and access can be issued or
      revoked per door without changing a lock.
    </p>

    <h2>Monitoring</h2>
    <p class="measure">
      A {home.security.system} camera system covers the entrances and the outside of the building.
      Stated plainly because it is something you should know before you book, not on arrival.
    </p>
    <ul class="cams">
      {home.security.cameras.map((c) => (
        <li>
          <span class="mono cam-count">{c.count}×</span>
          <span class="cam-type">{c.type}</span>
          <span class="muted">— {c.placement}</span>
        </li>
      ))}
    </ul>
    <p class="measure emphatic">{home.security.neverCovered}</p>
    <p class="measure">
      {home.security.residentAccess} That cuts both ways in a shared house: you can see who is at the
      door, and so can everyone else living here.
    </p>
    <p class="measure small">
      Footage is kept for <Fact value={home.security.retention} />. Others with access:
      {' '}<Fact value={home.security.otherViewers} />.
    </p>
    <p class="measure">Internet is provided.</p>

    <h2>Floorplans</h2>
    <p class="measure small muted">
      Drawings show the intended layout. The house is being renovated, so treat these as planned rather
      than installed until a plan is marked as-built.
    </p>
    {
      home.floorplans.map((fp) => (
        <div class="plan">
          <h3>
            {fp.label}
            {!fp.asBuilt && <span class="planned"> planned</span>}
          </h3>
          <ImageSlot
            value={fp.image}
            alt={`${fp.label} floorplan for ${property.address.street}.`}
            height={600}
            caption={`${fp.label} — drawing, not an as-built survey.`}
            why="Drawing not yet added to the site."
          />
          <dl class="plan-facts small">
            <div><dt class="micro">Dimensions</dt><dd class="mono"><Fact value={fp.dimensions} /></dd></div>
            <div><dt class="micro">Fixtures</dt><dd class="mono"><Fact value={fp.fixtures} /></dd></div>
            {fp.whichKitchen !== null && (
              <div><dt class="micro">Which kitchen</dt><dd class="mono"><Fact value={fp.whichKitchen} /></dd></div>
            )}
          </dl>
        </div>
      ))
    }

    <h2>Room by room</h2>
    {home.rooms.length === 0
      ? <p class="measure muted">No rooms have been photographed yet. They are posted as renovation finishes.</p>
      : <div class="rooms">{home.rooms.map((r) => <ImageSlot value={r.photo} alt={r.caption} caption={r.caption} />)}</div>}

    <p><a class="btn" href="/inquire">Apply for {home.availability.availableFrom.split(' ')[0]}</a></p>
  </section>
</Base>
<style>
  section { padding-block: var(--s12) var(--s8); }
  .plan { margin-block: var(--s8); }
  .plan h3 { margin-bottom: var(--s3); }
  .planned { font-weight: 400; font-size: 0.8125rem; letter-spacing: 0.04em;
             color: var(--paper); background: var(--brick); padding: 0.1em 0.5em;
             border-radius: 2px; margin-left: var(--s2); }
  .plan-facts { margin: var(--s4) 0 0; max-width: var(--measure); }
  .plan-facts > div { display: grid; gap: var(--s1); padding: var(--s2) 0;
                      border-bottom: 1px solid var(--limestone); }
  @media (min-width: 480px) { .plan-facts > div { grid-template-columns: 10rem 1fr; gap: var(--s4); } }
  .plan-facts dt { color: var(--text-muted); }
  .plan-facts dd { margin: 0; }
  .cams { list-style: none; padding: 0; max-width: var(--measure); }
  .cams li { display: flex; gap: var(--s2); align-items: baseline; padding: var(--s2) 0;
             border-bottom: 1px solid var(--limestone); }
  .cam-count { color: var(--sodium-deep); }
  .cam-type { font-weight: 600; }
  .emphatic { border-left: 3px solid var(--signal); padding-left: var(--s4); font-weight: 600; }
  .rooms { display: grid; gap: var(--s6); }
  @media (min-width: 768px) { .rooms { grid-template-columns: 1fr 1fr; } }
  .btn { display:inline-block; background:var(--ink); color:var(--paper); padding:var(--s3) var(--s8);
         text-decoration:none; font-weight:600; border-radius:2px; }
  .btn:hover { background: var(--brick); color: var(--paper); }
</style>
