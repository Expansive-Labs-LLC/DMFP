---
/**
 * `/commute` — the most conservative page on the site.
 *
 * CONTENT-OUTLINE: the method note goes ABOVE the table, not below it. A drive
 * time with no stated method or date is a number the reader cannot judge, so the
 * caveat leads rather than trails. Every measured value is a config path and
 * renders as a placeholder until it is actually measured.
 */
import Base from '../layouts/Base.astro';
import Fact from '../components/Fact.astro';
import FactTable from '../components/FactTable.astro';
import FacilityCard from '../components/FacilityCard.astro';
import { property, home } from '../data/site.config';
const c = property.commute;
const t = property.transit;
---

<Base
  title="Distance to each facility"
  description="Measured distance, drive time and transit from the house to Detroit Medical Center and Henry Ford Hospital."
>
  <section class="wrap stack">
    <h1 class="display-l">Distance to each facility.</h1>

    <p class="measure method">
      Times measured <Fact value={c.measuredAt} /> using <Fact value={c.method} />. Traffic varies.
      Confirm against your own route before you sign.
    </p>

    <h2>At a glance</h2>
    <FactTable
      caption={`From ${property.address.street}, ${property.address.locality}.`}
      columns={['Facility', 'Distance', 'Typical drive', 'Parking there']}
      rows={c.facilities.map((f) => ({ head: f.name, cells: [f.distance, f.driveTime, f.parking] }))}
    />

    <h2>Each facility</h2>
    {c.facilities.map((f) => <FacilityCard facility={f} />)}
    <p class="small muted">Not affiliated with either health system.</p>

    <h2>Getting around without a car</h2>
    <p class="measure">
      The {t.qline.name} is <strong>{t.qline.distance}</strong> from the house.
      {' '}{t.qline.description} Nearest stop: <Fact value={t.qline.nearestStop} />. Walk time:
      {' '}<Fact value={t.qline.walkTime} />.
    </p>
    <p class="measure"><Fact value={t.other} /></p>

    <h2>Parking at the house</h2>
    <p class="measure">
      {home.parking.onSiteSpots} spots at {home.parking.priceWeekly}, {home.parking.availability}.
      {' '}{home.parking.street} {home.parking.winterService}
    </p>

    <p class="small"><a href="/inquire">Ask about a specific route</a>.</p>
  </section>
</Base>

<style>
  section { padding-block: var(--s12) var(--s8); }
  .method { border-left: 3px solid var(--limestone-edge); padding-left: var(--s4); }
</style>
