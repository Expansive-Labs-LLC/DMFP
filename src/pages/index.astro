---
/**
 * `/` — Home (P0). Content per CONTENT-OUTLINE.md §"/ — Home".
 * Every fact is a config path. Nothing here is a literal. (FR-002, CON-004)
 */
import Base from '../layouts/Base.astro';
import { property, home, services, serviceDisplay } from '../data/site.config';
import { isTbd } from '../lib/fact';
import Fact from '../components/Fact.astro';
import StreetView from '../components/StreetView.astro';

const nearest = property.commute.facilities[0];
const liveServices = services.filter((s) => s.status === 'live');
const shownServices = services.filter(
  (s) => s.status === 'live' || (serviceDisplay.showNonLive && s.status === 'launching')
);
const avail = home.availability;
---

<Base
  title={`Furnished clinician housing in ${property.neighborhood}, Detroit`}
  description={`Furnished housing in Detroit's New Center area for clinicians on 30-day and longer assignments. Renovation underway, applications open for ${property.applications.forOccupancy} occupancy.`}
>
  <!-- 1. Day band hero -->
  <section class="hero on-ink">
    <div class="wrap">
      <h1 class="display-xl">A furnished room, by the week.</h1>
      <p class="standfirst measure">
        {home.bedrooms} bedrooms, {home.bathroomsFull} full bathrooms and {home.kitchens} kitchens in
        Detroit's {property.neighborhood} area. Rooms are let week by week, with food, laundry and
        cleaning available on top.
        <strong>
          Renovation is underway now and applications are open for {property.applications.forOccupancy}.
        </strong>
      </p>
      <StreetView
        eager
        capturedLabel={property.photos.streetViewCaptured}
        note={property.photos.streetViewNote}
      />

    </div>
  </section>

  <!-- 2. Three proof blocks -->
  <section class="wrap proof">
    <h2>
      Travel nurse housing in Detroit, near {nearest.name}
    </h2>
    <div class="proof-grid">
      <article class="stack">
        <h3>Commute</h3>
        <p class="data mono">
          <Fact value={nearest.distance} /> · <Fact value={nearest.driveTime} />
        </p>
        <p class="small muted">to {nearest.name}</p>
        <p class="small"><a href="/commute">See all facilities →</a></p>
      </article>

      <article class="stack">
        <h3>Included</h3>
        {
          liveServices.length === 0 ? (
            <p class="small muted">No services are confirmed live yet.</p>
          ) : (
            <p class="data mono">{liveServices.length} confirmed</p>
          )
        }
        <ul class="small plain">
          {
            shownServices.slice(0, 3).map((s) => (
              <li>
                {s.name}
                {s.status === 'launching' && (
                  <span class="from">
                    {' '}
                    {isTbd(s.liveFrom) ? <Fact value={s.liveFrom} /> : `from ${s.liveFrom}`}
                  </span>
                )}
              </li>
            ))
          }
        </ul>
        <p class="small"><a href="/whats-included">What's included →</a></p>
      </article>

      <!-- The block that renders real content from launch. -->
      <article class="stack badge">
        <h3>Pre-leasing</h3>
        <p class="small">
          Renovation underway. First occupancy {avail.availableFrom}. Applications are open now.
        </p>
        <p class="data mono rate">from <Fact value={home.terms.rateRoomWeeklyFrom} /></p>
        <p class="small muted">per bedroom, per week</p>
        <p class="small"><a href="/the-house#rooms">All six rooms and rates →</a></p>
      </article>
    </div>
  </section>

  <!-- 3. Who this is for -->
  <section class="wrap">
    <div class="measure stack">
      <h2>Who this is for</h2>
      <p>
        The house has {home.bedrooms} bedrooms, {home.bathroomsFull} full bathrooms and {home.kitchens}
        kitchens — a full kitchen and a kitchenette. It is furnished, with laundry in the house and its
        own entrance. Rooms are let by the week, from {home.terms.minWeeks} week — a clinical contract
        is usually {home.terms.typicalContractWeeks} weeks. Two kitchens and {home.bathroomsFull} full
        bathrooms means six people are not queuing for one of each. The building also divides into {home.divisible.units} self-contained units with
        separately split utilities, so it can be taken a room at a time, a unit at a time, or whole.
        Food, laundry and cleaning are available on top, so a week here does not have to include a
        grocery run. The house is being renovated now, and the first occupancy is {
          avail.availableFrom
        }. If you need a night or a weekend, this is not the right place.
      </p>
    </div>
  </section>

  <!-- 4. CTA -->
  <section class="wrap cta stack">
    <a class="btn" href="/inquire">Apply for {avail.availableFrom.split(' ')[0]}</a>
    <p class="small">Booking for a clinician? See <a href="/for-agencies">For agencies</a>.</p>
  </section>

  <!-- 5. Below the fold -->
  <nav class="wrap more" aria-label="Explore">
    <a href="/the-house">The house</a>
    <a href="/commute">Commute</a>
    <a href="/whats-included">What's included</a>
  </nav>
</Base>

<style>
  .hero {
    padding-block: var(--s12) var(--s16);
  }
  .hero :global(.sv) { margin-top: var(--s8); }
  .standfirst {
    font-size: 1.125rem;
    margin: var(--s6) 0 var(--s12);
  }
  .proof {
    padding-block: var(--s16) var(--s8);
  }
  .proof-grid {
    display: grid;
    gap: var(--s8);
    margin-top: var(--s8);
  }
  @media (min-width: 768px) {
    .proof-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .data {
    font-size: 1.25rem;
  }
  .rate {
    font-size: 1.5rem;
  }
  .badge {
    border-left: 3px solid var(--signal);
    padding-left: var(--s4);
  }
  .from {
    color: var(--sodium-deep);
  }
  ul.plain {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  ul.plain li + li {
    margin-top: var(--s1);
  }
  .cta {
    padding-block: var(--s16);
  }
  .btn {
    display: inline-block;
    background: var(--ink);
    color: var(--paper);
    padding: var(--s3) var(--s8);
    text-decoration: none;
    font-weight: 600;
    border-radius: 2px;
  }
  .btn:hover {
    background: var(--brick);
    color: var(--paper);
  }
  .more {
    display: flex;
    gap: var(--s6);
    flex-wrap: wrap;
    border-top: 1px solid var(--limestone);
    padding-top: var(--s8);
  }
</style>
